          {
            "id": "eyes-aversion",
            "signalId": "EYE-002",
            "label": {
              "ru": "Отведение взгляда",
              "en": "Looking away"
            },
            "region": {
              "shape": "ellipse",
              "cx": 23,
              "cy": 27,
              "rx": 13,
              "ry": 6
            },
            "reliability": "disputed",
            "myth": true,
            "tier": "free",
            "layers": {
              "seen": {
                "ru": "Человек смотрит вниз или в сторону, пока отвечает на сложный вопрос.",
                "en": "The person looks down or to the side while answering a hard question."
              },
              "notProven": {
                "ru": "Отведённый взгляд сам по себе — слабый маркер: так выглядит и подбор слов, и стеснение. Ценность появляется, когда он совпадает с темой вопроса.",
                "en": "Averted gaze alone is a weak marker: word-searching and shyness look the same. It gains value when it lines up with the topic of the question."
              },
              "alt": {
                "ru": [
                  "Человек вспоминает или подбирает слова",
                  "Ему неловко смотреть в глаза (стеснительность, культура)",
                  "Нейроразнообразие",
                  "Отвлёк шум"
                ],
                "en": [
                  "The person is recalling or choosing words",
                  "Eye contact feels awkward (shyness, culture)",
                  "Neurodiversity",
                  "A distraction"
                ]
              },
              "check": {
                "ru": [
                  "«Мне показалось, вы задумались. Хотите вернуться к этому вопросу позже?»",
                  "«Давайте вернёмся к этому, когда вам будет удобно.»",
                  "«Расскажите, как вы это запомнили?»",
                  "«Уточните: это было до или после подписания?»"
                ],
                "en": [
                  "'You seemed to be thinking. Would you like to come back to this later?'",
                  "'Let us come back to this when it suits you.'",
                  "'How do you remember it?'",
                  "'Clarify: was that before or after signing?'"
                ]
              },
              "physiology": {
                "ru": "Взгляд уходит, когда мозгу нужны ресурсы: вспоминание и подбор слов занимают внимание, а зрительный контакт его отвлекает. Тот же эффект даёт стеснение.",
                "en": "Gaze drifts when the brain needs resources: recalling and choosing words takes attention and eye contact competes for it. Shyness has the same effect."
              },
              "fixation": {
                "ru": "Если взгляд уходит именно на одном вопросе и снова при его повторе — наиболее вероятно, тема требует от человека усилия. Зафиксируйте тему и вернитесь к ней через факты.",
                "en": "If the gaze leaves on one question and again when it is repeated, the topic most likely costs the person effort. Note the topic and return to it through facts."
              }
            },
            "research": {
              "ru": "DePaulo и др., 2003; ссылка в research/01 (вторичный пересказ). Проверить первоисточник перед релизом.",
              "en": "DePaulo et al., 2003; see research/01 (secondary summary). Verify the primary source before release."
            },
            "pin": {
